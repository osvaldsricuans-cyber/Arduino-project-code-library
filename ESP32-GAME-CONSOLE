void checkExit() {
  if (digitalRead(PIN_LEFT) == LOW) { currentMode = 0; noTone(PIN_BUZZER); delay(300); }
}

void setup() {
  u8g2.begin();
  EEPROM.begin(64); 
  hsDino = EEPROM.read(0); hsSnake = EEPROM.read(4);
  pinMode(PIN_VRX, INPUT); pinMode(PIN_VRY, INPUT);
  pinMode(PIN_UP, INPUT_PULLUP); pinMode(PIN_DOWN, INPUT_PULLUP);
  pinMode(PIN_LEFT, INPUT_PULLUP); pinMode(PIN_RIGHT, INPUT_PULLUP);
  pinMode(PIN_BUZZER, OUTPUT);
}

// --- SNAKE GAME ---
void runSnake() {
  checkExit();
  if (millis() - globalTimer < 150) return; 
  globalTimer = millis();

  int rx = analogRead(PIN_VRX), ry = analogRead(PIN_VRY);
  if (rx < 1000 && snDir != 1) snDir = 3;
  else if (rx > 3000 && snDir != 3) snDir = 1;
  else if (ry < 1000 && snDir != 2) snDir = 0;
  else if (ry > 3000 && snDir != 0) snDir = 2;

  for (int i = snLen; i > 0; i--) { snX[i] = snX[i-1]; snY[i] = snY[i-1]; }
  if (snDir == 0) snY[0]--; else if (snDir == 1) snX[0]++; else if (snDir == 2) snY[0]++; else if (snDir == 3) snX[0]--;

  // Collision with Body
  for (int i = 1; i < snLen; i++) {
    if (snX[0] == snX[i] && snY[0] == snY[i]) {
      tone(PIN_BUZZER, 150, 400); snLen = 3; snX[0] = 10; snY[0] = 5;
    }
  }

  if (snX[0] == foodX && snY[0] == foodY) { snLen++; foodX = random(2, 19); foodY = random(2, 9); tone(PIN_BUZZER, 1500, 50); }
  if (snX[0] < 0 || snX[0] > 20 || snY[0] < 0 || snY[0] > 9) { tone(PIN_BUZZER, 150, 400); snLen = 3; snX[0] = 10; snY[0] = 5; }

  u8g2.clearBuffer();
  u8g2.drawFrame(0, 0, 128, 64);
  u8g2.drawBox(foodX*6, foodY*6, 5, 5); // Food
  u8g2.drawBox(snX[0]*6, snY[0]*6, 5, 5); // Head (Solid)
  for (int i = 1; i < snLen; i++) u8g2.drawFrame(snX[i]*6, snY[i]*6, 5, 5); // Body (Outline)
  u8g2.sendBuffer();
}

// --- PONG GAME ---
void runPong() {
  checkExit();
  if (millis() - globalTimer < 30) return;
  globalTimer = millis();

  // Player Control (Joystick VRY)
  int ry = analogRead(PIN_VRY);
  if (ry < 1000) playerY -= 3; if (ry > 3000) playerY += 3;
  playerY = constrain(playerY, 0, 48);

  // AI Control
  if (ballY > aiY + 8) aiY += 2; else if (ballY < aiY + 8) aiY -= 2;
  aiY = constrain(aiY, 0, 48);

  // Ball Movement
  ballX += ballDX; ballY += ballDY;
  if (ballY <= 0 || ballY >= 60) ballDY = -ballDY;

  // Collision Player
  if (ballX <= 10 && ballY >= playerY && ballY <= playerY + 16) { ballDX = -ballDX; tone(PIN_BUZZER, 1000, 20); }
  // Collision AI
  if (ballX >= 118 && ballY >= aiY && ballY <= aiY + 16) { ballDX = -ballDX; tone(PIN_BUZZER, 1000, 20); }

  // Scoring
  if (ballX < 0) { aiScore++; ballX = 64; ballDX = 3; tone(PIN_BUZZER, 200, 200); }
  if (ballX > 128) { pScore++; ballX = 64; ballDX = -3; tone(PIN_BUZZER, 1200, 100); }

  u8g2.clearBuffer();
  u8g2.drawFrame(0, 0, 128, 64);
  u8g2.drawBox(5, playerY, 4, 16); // Player
  u8g2.drawBox(119, aiY, 4, 16);  // AI
  u8g2.drawDisc(ballX, ballY, 2);  // Ball
  u8g2.setCursor(40, 12); u8g2.print(pScore); u8g2.setCursor(80, 12); u8g2.print(aiScore);
  u8g2.sendBuffer();
}

