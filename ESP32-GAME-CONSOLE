void loop() {
  if (currentMode == 0) {
    u8g2.clearBuffer(); u8g2.setFont(u8g2_font_ncenB08_tr);
    u8g2.drawStr(30, 15, "GAME SELECT");
    for(int i=0; i<4; i++) {
      if (i == selectedGame) u8g2.drawButtonUTF8(5, 25+(i*10), U8G2_BTN_INV, 118, 0, 1, gameNames[i]);
      else u8g2.drawStr(10, 25+(i*10), gameNames[i]);
    }
    if (digitalRead(PIN_UP) == LOW) { selectedGame = (selectedGame > 0) ? selectedGame - 1 : 3; delay(200); }
    if (digitalRead(PIN_DOWN) == LOW) { selectedGame = (selectedGame < 3) ? selectedGame + 1 : 0; delay(200); }
    if (digitalRead(PIN_RIGHT) == LOW) { currentMode = selectedGame + 1; delay(300); }
    u8g2.sendBuffer();
  } 
  else if (currentMode == 1) runMaze();
  else if (currentMode == 2) runDino();
  else if (currentMode == 3) runSnake();
  else if (currentMode == 4) runPong();
}
